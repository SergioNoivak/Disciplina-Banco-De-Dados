\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 1. Quantidade de vendas por vendedor}
\PYG{k}{SELECT}\PYG{+w}{ }\PYG{n}{vendedor\PYGZus{}id}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{COUNT}\PYG{p}{(}\PYG{n}{id}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{AS}\PYG{+w}{ }\PYG{n}{total\PYGZus{}vendas}
\PYG{k}{FROM}\PYG{+w}{ }\PYG{n}{venda}
\PYG{k}{GROUP}\PYG{+w}{ }\PYG{k}{BY}\PYG{+w}{ }\PYG{n}{vendedor\PYGZus{}id}\PYG{p}{;}

\PYG{c+c1}{\PYGZhy{}\PYGZhy{} 2. Filtro com HAVING}
\PYG{k}{SELECT}\PYG{+w}{ }\PYG{n}{vendedor\PYGZus{}id}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{COUNT}\PYG{p}{(}\PYG{n}{id}\PYG{p}{)}\PYG{+w}{ }\PYG{k}{AS}\PYG{+w}{ }\PYG{n}{total\PYGZus{}vendas}
\PYG{k}{FROM}\PYG{+w}{ }\PYG{n}{venda}
\PYG{k}{GROUP}\PYG{+w}{ }\PYG{k}{BY}\PYG{+w}{ }\PYG{n}{vendedor\PYGZus{}id}
\PYG{k}{HAVING}\PYG{+w}{ }\PYG{k}{COUNT}\PYG{p}{(}\PYG{n}{id}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{l+m+mi}{10}\PYG{p}{;}
\end{Verbatim}
