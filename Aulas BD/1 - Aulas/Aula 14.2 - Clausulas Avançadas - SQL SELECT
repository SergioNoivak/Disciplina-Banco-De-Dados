SELECT *
FROM itens_nf;

SELECT
    id_nf,
    SUM(valor_unit * quantidade) AS total_nf
FROM itens_nf
GROUP BY id_nf
HAVING SUM(valor_unit * quantidade) > 100
ORDER BY id_nf ASC;

SELECT
    nome,
    id_cliente
FROM cliente
ORDER BY nome DESC;

SELECT
    nome,
    id_cliente
FROM cliente
ORDER BY nome ASC
LIMIT 5 OFFSET 10;

SELECT DISTINCT
    id_endereco
FROM cliente;

SELECT
    nome AS dado
FROM cliente
UNION
SELECT
    logradouro AS dado
FROM endereco
ORDER BY dado ASC;

SELECT
    id_nf,
    cod_prod,
    (quantidade * valor_unit) AS valor_total,
    AVG(valor_unit * quantidade) OVER (PARTITION BY id_nf) AS media_nf
FROM itens_nf;
