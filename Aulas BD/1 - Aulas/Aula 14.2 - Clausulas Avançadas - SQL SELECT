-- ============================================
-- CRIAÇÃO DAS TABELAS SE NÃO EXISTIREM
-- ============================================
-- Endereços
CREATE TABLE IF NOT EXISTS endereco (
    id_endereco SERIAL PRIMARY KEY,
    logradouro VARCHAR(250) NOT NULL
);

-- Clientes
CREATE TABLE IF NOT EXISTS cliente (
    id_cliente SERIAL PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    id_endereco INT DEFAULT 1,
    FOREIGN KEY (id_endereco) REFERENCES endereco (id_endereco)
        ON UPDATE CASCADE
        ON DELETE SET DEFAULT
);

-- Condição de Pagamento
CREATE TABLE IF NOT EXISTS condicao_pagamento (
    id_condicao SERIAL PRIMARY KEY,
    descricao VARCHAR(80) NOT NULL
);

-- Nota Fiscal
CREATE TABLE IF NOT EXISTS nota_fiscal (
    id_nf SERIAL PRIMARY KEY,
    data_emissao TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    id_cliente INT NOT NULL,
    id_condicao INT,
    FOREIGN KEY (id_cliente) REFERENCES cliente (id_cliente)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    FOREIGN KEY (id_condicao) REFERENCES condicao_pagamento (id_condicao)
        ON UPDATE CASCADE
        ON DELETE SET NULL
);

-- Produtos
CREATE TABLE IF NOT EXISTS produto (
    cod_prod SERIAL PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL,
    preco_venda NUMERIC(10,2) NOT NULL
);

-- Itens da Nota Fiscal
CREATE TABLE IF NOT EXISTS itens_nf (
    id_nf INT NOT NULL,
    cod_prod INT NOT NULL,
    valor_unit NUMERIC(10,2) NOT NULL,
    quantidade INT NOT NULL,
    PRIMARY KEY (id_nf, cod_prod),
    FOREIGN KEY (id_nf) REFERENCES nota_fiscal (id_nf)
        ON UPDATE CASCADE
        ON DELETE CASCADE,
    FOREIGN KEY (cod_prod) REFERENCES produto (cod_prod)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

-- ============================================
-- LIMPEZA DO BANCO (ordem respeitando as FKs)
-- ============================================
